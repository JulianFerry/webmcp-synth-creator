{
  "version": 1,
  "metadata": {
    "name": "Warm Mono Bass",
    "category": "bass",
    "description": "A focused mono bass with a warm saw fundamental and restrained square sub layer.",
    "tags": ["mono", "warm", "sub"]
  },
  "oscillators": [
