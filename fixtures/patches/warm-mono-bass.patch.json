      "enabled": true,
      "wavetableId": "saw",
      "wavetablePosition": 0.72,
      "level": 0.72,
      "transposeSemitones": -12,
      "fineTuneCents": 0,
      "unisonVoices": 1,
      "unisonDetune": 0,
      "stereoSpread": 0,
      "randomPhase": 0
    },
    {
      "enabled": true,
      "wavetableId": "soft-square",
      "wavetablePosition": 0.64,
      "level": 0.32,
      "transposeSemitones": -24,
      "fineTuneCents": 0,
      "unisonVoices": 1,
      "unisonDetune": 0,
      "stereoSpread": 0,
      "randomPhase": 0
    }
  ],
  "ampEnvelope": {
    "attackSeconds": 0.008,
    "holdSeconds": 0,
    "decaySeconds": 0.34,
    "sustainLevel": 0.78,
    "releaseSeconds": 0.16
  },
  "modEnvelope": {
    "attackSeconds": 0.004,
    "holdSeconds": 0,
    "decaySeconds": 0.42,
    "sustainLevel": 0.08,
    "releaseSeconds": 0.18
