{
  "name": "webmcp-synth-creator",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "setup:first-run": "bash wasm/vital/setup.sh",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && PLAYWRIGHT_PREVIEW=1 playwright test --project=chromium tests/e2e/startup-audition.spec.ts tests/e2e/vertical-slice.spec.ts tests/e2e/vital-import.spec.ts tests/e2e/responsive.spec.ts tests/e2e/workbench-tabs.spec.ts",
    "test:e2e:deployment": "playwright test tests/e2e/deployment-smoke.spec.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
